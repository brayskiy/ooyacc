def f(x) = x^2;
integrate(f, 0, 1);
def g(x) = x^3;
integrate(g, 0, 2);
def p(x) = 3*x^2 + 2*x + 1;
integrate(p, 0, 1);
def h(x) = x^4;
integrate(h, -1, 1);
def poly(x) = x^5;
integrate(poly, 0, 1);
def sq(x) = x*x;
def quad(x) = sq(x) + 1;
quad(3);
integrate(quad, 0, 3);
def s(x) = sin(x);
integrate(s, 0, 3.141592653589793);
f(5);
